{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasa-omni.local/eval/gold.schema.json",
  "title": "Gold object (one line of gold.jsonl)",
  "description": "AC-EVAL-1. t is seconds since manifest.start_time; bbox is [x1, y1, x2, y2] normalised to 0..1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gold_object_id", "catalog_id", "is_unknown", "appearances", "events"],
  "properties": {
    "gold_object_id": {"type": "string", "minLength": 1},
    "catalog_id": {"type": ["string", "null"], "minLength": 1},
    "is_unknown": {"type": "boolean"},
    "appearances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "location"],
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "location": {"type": "string", "minLength": 1},
          "bbox": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number", "minimum": 0, "maximum": 1}
              }
            ]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "t"],
        "properties": {
          "type": {
            "enum": ["moved", "added", "removed", "used", "handed_over", "seen", "stowed", "unstowed", "consumed"]
          },
          "t": {"type": "number", "minimum": 0},
          "actor": {"type": ["string", "null"]},
          "to_location": {"type": ["string", "null"]}
        }
      }
    }
  },
  "if": {"properties": {"is_unknown": {"const": true}}, "required": ["is_unknown"]},
  "then": {"properties": {"catalog_id": {"type": "null"}}},
  "else": {"properties": {"catalog_id": {"type": "string"}}}
}
