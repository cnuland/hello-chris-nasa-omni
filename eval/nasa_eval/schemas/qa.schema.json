{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasa-omni.local/eval/qa.schema.json",
  "title": "Chatbot QA item (one line of qa.jsonl)",
  "description": "AC-EVAL-4. entity answers list gold_object_ids; location answers are exact location ids; actor answers are a descriptor or a gold person id; free_text answers are judged against a rubric.",
  "type": "object",
  "additionalProperties": false,
  "required": ["qa_id", "question", "answer_type", "expected"],
  "properties": {
    "qa_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer_type": {"enum": ["entity", "location", "actor", "free_text"]},
    "expected": {"type": "object"},
    "rubric": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"answer_type": {"const": "entity"}}, "required": ["answer_type"]},
      "then": {
        "properties": {
          "expected": {
            "required": ["entities"],
            "properties": {"entities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"answer_type": {"const": "location"}}, "required": ["answer_type"]},
      "then": {
        "properties": {
          "expected": {"required": ["location"], "properties": {"location": {"type": "string", "minLength": 1}}}
        }
      }
    },
    {
      "if": {"properties": {"answer_type": {"const": "actor"}}, "required": ["answer_type"]},
      "then": {
        "properties": {
          "expected": {"required": ["actor"], "properties": {"actor": {"type": "string", "minLength": 1}}}
        }
      }
    },
    {
      "if": {"properties": {"answer_type": {"const": "free_text"}}, "required": ["answer_type"]},
      "then": {"required": ["rubric"]}
    }
  ]
}
