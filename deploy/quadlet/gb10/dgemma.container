# GB10 variant of dgemma: one GPU, TP 1, no sm75 patches (Blackwell). See ../dgemma.container for the 4x T4 one.
#   --tensor-parallel-size=1   there is one GPU
#   --gpu-memory-utilization   0.30 of 128 GB unified (~38 GB): INT8 weights plus KV at 4k
#   PublishPort on loopback    avoids the host port 8000 clash with gemma4 on a single host
[Unit]
Description=NASA POC - dgemma (decision model, vLLM, GB10)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=dgemma
Image=docker.io/vllm/vllm-openai:v0.31.0
AddDevice=nvidia.com/gpu=all
Network=nasa.network
PublishPort=127.0.0.1:8010:8000
Volume=/var/lib/nasa/models:/cache:z
Volume=/etc/nasa/vllm-start.sh:/vllm-start.sh:ro,z
Environment=HOME=/cache HF_HOME=/cache/hf VLLM_CACHE_ROOT=/cache/vllm TRITON_CACHE_DIR=/cache/triton CUDA_MODULE_LOADING=EAGER HF_HUB_ENABLE_HF_TRANSFER=0
PodmanArgs=--shm-size=16g --entrypoint=/bin/bash
Exec=/vllm-start.sh aidendle94/diffusiongemma-26B-A4B-it-INT8-dynamic --served-model-name=dgemma --host=0.0.0.0 --port=8000 '--diffusion-config={"canvas_length":64}' --max-logprobs=32 --max-model-len=4096 --max-num-seqs=1 --tensor-parallel-size=1 --dtype=bfloat16 --moe-backend=humming '--limit-mm-per-prompt={"image":2}' --gpu-memory-utilization=0.30
HealthCmd=curl -sf http://127.0.0.1:8000/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
# No Triton JIT warm-up to wait for on Blackwell, unlike the 40-minute first start on T4.
HealthStartPeriod=900s

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
