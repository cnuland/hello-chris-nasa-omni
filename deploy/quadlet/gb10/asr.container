# GB10 variant of asr (Whisper). See ../asr.container for the 4x T4 one.
#   AddDevice=nvidia.com/gpu=all   the T4 unit pinned GPU 3, which does not exist on a one-GPU GB10
#   --gpu-memory-utilization 0.05  (~6 GB) of the shared 128 GB
[Unit]
Description=NASA POC - asr (Whisper, vLLM, GB10)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=asr
Image=docker.io/vllm/vllm-openai:v0.31.0
AddDevice=nvidia.com/gpu=all
Network=nasa.network
PublishPort=127.0.0.1:8001:8000
Volume=/var/lib/nasa/models:/cache:z
Volume=/etc/nasa/vllm-start.sh:/vllm-start.sh:ro,z
Environment=HOME=/cache HF_HOME=/cache/hf CUDA_MODULE_LOADING=EAGER VLLM_AUDIO_EXTRAS=1
PodmanArgs=--entrypoint=/bin/bash
Exec=/vllm-start.sh openai/whisper-large-v3-turbo --served-model-name=asr --host=0.0.0.0 --port=8000 --dtype=bfloat16 --gpu-memory-utilization=0.05 --enforce-eager --max-num-seqs=4
HealthCmd=curl -sf http://127.0.0.1:8000/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=600s

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
