[Unit]
Description=NASA POC - agent memory compression ("dreaming"), one pass
Requires=nasa-app.service
After=nasa-app.service

[Service]
Type=oneshot
# agent-chat is the container name podman gives the "chat" container of the "agent" pod in kube/app.yaml.
ExecStart=/usr/bin/podman exec agent-chat python -m nasa_agent.dreaming --once
