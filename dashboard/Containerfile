# Build: podman build -t nasa-omni-dashboard -f Containerfile .
FROM docker.io/library/node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Runtime: unprivileged nginx (OpenShift arbitrary UID friendly), listens on 8080.
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
ENV API_UPSTREAM=http://inventory-api:8080 \
    AGENT_UPSTREAM=http://agent:8080 \
    NGINX_ENVSUBST_FILTER="^(API|AGENT)_UPSTREAM$"
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
